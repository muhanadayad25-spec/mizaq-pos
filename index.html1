
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>نظام المبيعات</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f2f5f9;
      color: #172033;
    }
    header {
      background: #102b50;
      color: white;
      padding: 20px;
      text-align: center;
    }
    main {
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 18px;
      padding: 20px;
    }
    section {
      background: white;
      border-radius: 12px;
      padding: 18px;
    }
    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 12px;
    }
    button {
      border: 0;
      border-radius: 8px;
      padding: 13px;
      cursor: pointer;
      font-size: 15px;
    }
    .product {
      background: #edf4ff;
      color: #102b50;
      min-height: 85px;
    }
    .product strong, .product span { display: block; margin: 6px; }
    .checkout {
      width: 100%;
      background: #147d54;
      color: white;
      margin-top: 12px;
    }
    .clear {
      width: 100%;
      background: #fce8e8;
      color: #a52222;
      margin-top: 8px;
    }
    .cart-row {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      padding: 10px 0;
      border-bottom: 1px solid #eee;
    }
    .total {
      font-size: 20px;
      font-weight: bold;
      margin-top: 18px;
    }
    @media (max-width: 700px) {
      main { grid-template-columns: 1fr; padding: 10px; }
    }
  </style>
</head>
<body>
  <header>
    <h1>نظام المبيعات</h1>
    <p>إدارة المطاعم والكافيهات</p>
  </header>

  <main>
    <section>
      <h2>الأصناف</h2>
      <div class="products" id="products"></div>
    </section>

    <section>
      <h2>الطلب الحالي</h2>
      <div id="cart"></div>
      <div class="total">الإجمالي: <span id="total">0</span> ج.س</div>
      <button class="checkout" onclick="checkout()">إتمام البيع</button>
      <button class="clear" onclick="clearCart()">إلغاء الطلب</button>
      <p id="message" role="status"></p>
    </section>
  </main>

  <script>
    const items = [
      {id: 1, name: "بيتزا", price: 15000},
      {id: 2, name: "برجر", price: 10000},
      {id: 3, name: "دجاج بروست", price: 18000},
      {id: 4, name: "بطاطس", price: 5000},
      {id: 5, name: "عصير", price: 3000},
      {id: 6, name: "قهوة", price: 4000}
    ];

    let cart = [];

    function money(n) {
      return n.toLocaleString("en-US");
    }

    function renderProducts() {
      document.getElementById("products").innerHTML =
        items.map(item => `
          <button class="product" onclick="addItem(${item.id})">
            <strong>${item.name}</strong>
            <span>${money(item.price)} ج.س</span>
          </button>
        `).join("");
    }

    function addItem(id) {
      const found = cart.find(x => x.id === id);
      if (found) found.qty++;
      else cart.push({...items.find(x => x.id === id), qty: 1});
      renderCart();
    }

    function renderCart() {
      document.getElementById("cart").innerHTML = cart.length
        ? cart.map(item => `
          <div class="cart-row">
            <span>${item.name} × ${item.qty}</span>
            <span>${money(item.price * item.qty)} ج.س</span>
          </div>
        `).join("")
        : "لا توجد أصناف في الطلب";

      document.getElementById("total").textContent =
        money(cart.reduce((sum, item) => sum + item.price * item.qty, 0));
    }

    function checkout() {
      if (!cart.length) {
        document.getElementById("message").textContent = "أضف صنفاً أولاً";
        return;
      }

      const sales = JSON.parse(localStorage.getItem("sales") || "[]");
      sales.push({
        id: Date.now(),
        date: new Date().toISOString(),
        items: cart,
        total: cart.reduce((sum, item) => sum + item.price * item.qty, 0)
      });

      localStorage.setItem("sales", JSON.stringify(sales));
      cart = [];
      renderCart();
      document.getElementById("message").textContent =
        "تم حفظ البيع على هذا الجهاز";
    }

    function clearCart() {
      cart = [];
      renderCart();
      document.getElementById("message").textContent = "";
    }

    renderProducts();
    renderCart();
  </script>
</body>
</html>
